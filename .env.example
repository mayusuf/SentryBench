# ── SentryBench environment template ──────────────────────────────────────────
# Copy this file to `.env` and fill in your own values.
#   cp .env.example .env         (macOS/Linux)
#   Copy-Item .env.example .env  (Windows PowerShell)
# `.env` is git-ignored — never commit real secrets. Rotate any key you expose.

# ── Anthropic (Claude) — REQUIRED for the `claude` and `haiku` models ─────────
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here

# Optional model-snapshot overrides (defaults shown). Run `cli doctor` to list
# the snapshots available on your key.
# SENTRYBENCH_CLAUDE_MODEL=claude-sonnet-4-5-20250929
# SENTRYBENCH_CLAUDE_HAIKU_MODEL=claude-haiku-4-5-20251001

# ── Azure OpenAI (GPT-5) — REQUIRED for the `gpt5` model ──────────────────────
AZURE_OPENAI_API_KEY=your-azure-openai-key-here
AZURE_OPENAI_ENDPOINT=https://YOUR-RESOURCE.openai.azure.com/
AZURE_OPENAI_API_VERSION=2024-12-01-preview
AZURE_OPENAI_DEPLOYMENT=gpt-5

# ── Hugging Face — OPTIONAL (only improves datasets-server rate limits) ───────
# Public datasets load without a token; set this if you hit HTTP 429s.
HF_API_KEY=hf_your-huggingface-token-here
